{
  "name": "plugin-doc-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:full": "npm run fetch-docs && next build",
    "build:cache": "npm run fetch-docs:cache && next build",
    "dev": "next dev",
    "start": "serve out",
    "fetch-docs": "tsx scripts/fetch-docs.ts",
    "fetch-docs:cache": "tsx scripts/fetch-docs.ts --cache-only",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.10",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@octokit/rest": "^22.0.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
